{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulscope.local/schemas/evidence-ledger-record.schema.json",
  "title": "SoulScope Evidence Ledger Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "marker_id",
    "marker_version",
    "scan_id",
    "prompt_scope",
    "time_scope",
    "reference_scope",
    "source_measurement_ids",
    "source_feature_families",
    "direction",
    "quality",
    "supporting_components",
    "contradicting_components",
    "missing_components",
    "confound_flags",
    "rule_id",
    "rule_version",
    "status",
    "timestamp",
    "provenance",
    "version"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "marker_id": {
      "enum": [
        "PROSODIC_EXPANSION",
        "PROSODIC_COMPRESSION",
        "PAUSE_LOAD_INCREASE",
        "TEMPORAL_FRAGMENTATION",
        "OUTPUT_CONTINUITY",
        "PHONATORY_SHIFT",
        "PHONATORY_STABILITY",
        "MODULATION_BREADTH",
        "CONTEXT_RECONFIGURATION",
        "CONTEXT_CONSISTENCY",
        "WITHIN_PROMPT_DRIFT"
      ]
    },
    "marker_version": { "type": "string", "minLength": 1 },
    "scan_id": { "type": "string", "minLength": 1 },
    "prompt_scope": {
      "type": "array",
      "items": {
        "enum": ["P1_OPEN_REFERENCE", "P2_TROUBLING_CONTEXT", "P3_FUTURE_CONTEXT"]
      }
    },
    "time_scope": {
      "type": "object",
      "properties": {
        "start_time": { "type": ["number", "null"] },
        "end_time": { "type": ["number", "null"] }
      }
    },
    "reference_scope": {
      "type": "object",
      "required": ["reference_type"],
      "properties": {
        "reference_type": { "type": "string", "minLength": 1 },
        "reference_id": { "type": ["string", "null"] }
      }
    },
    "source_measurement_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_feature_families": {
      "type": "array",
      "items": { "enum": ["PRO", "ENG", "TIM", "PHO", "SPE", "DYN"] }
    },
    "value": { "type": ["number", "string", "boolean", "null"] },
    "direction": { "enum": ["LOWER", "HIGHER", "NONE", "MIXED", "UNRESOLVED"] },
    "magnitude": { "type": ["number", "null"] },
    "uncertainty": { "type": ["number", "null"] },
    "quality": { "type": "object" },
    "coverage": { "type": ["number", "null"] },
    "agreement": { "type": ["number", "null"] },
    "baseline_trust": { "type": ["number", "null"] },
    "supporting_components": { "type": "array", "items": { "type": "string" } },
    "contradicting_components": { "type": "array", "items": { "type": "string" } },
    "missing_components": { "type": "array", "items": { "type": "string" } },
    "confound_flags": { "type": "array", "items": { "type": "string" } },
    "rule_id": { "type": "string", "minLength": 1 },
    "rule_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["RESOLVED", "PARTIALLY_RESOLVED", "UNRESOLVED", "SUPPRESSED", "INVALID", "RESEARCH_ESTIMATE"] },
    "resolution_reason": { "type": "string" },
    "timestamp": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "provenance.schema.json" },
    "version": { "$ref": "version-reference.schema.json" }
  }
}
