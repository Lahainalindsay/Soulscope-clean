{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soulscope.local/schemas/canonical-registry-entry.schema.json",
  "title": "SoulScope Canonical Registry Entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "registryVersion", "provenance"],
  "anyOf": [
    { "required": ["label"] },
    { "required": ["displayName"] }
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "COG",
        "REG",
        "CAP",
        "EXP",
        "COG-P1",
        "COG-P2",
        "COG-P3",
        "COG-P4",
        "REG-P1",
        "REG-P2",
        "REG-P3",
        "REG-P4",
        "CAP-P1",
        "CAP-P2",
        "CAP-P3",
        "CAP-P4",
        "EXP-P1",
        "EXP-P2",
        "EXP-P3",
        "EXP-P4",
        "COG-S01",
        "COG-S02",
        "REG-S01",
        "REG-S02",
        "CAP-S01",
        "CAP-S02",
        "EXP-S01",
        "EXP-S02"
      ]
    },
    "label": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "registryVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "provenance": { "$ref": "provenance.schema.json" }
  }
}
