{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reflection-narrative-v1.schema.json",
  "title": "ReflectionNarrativeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "languageVersion",
    "canonVersion",
    "sourceResultId",
    "status",
    "strongestObservation",
    "overview",
    "dailyLife",
    "questionToSitWith",
    "alternatives",
    "evidenceRefs",
    "decisionRefs",
    "meaningUnitRefs",
    "unresolved"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reflection-narrative.v1"
    },
    "languageVersion": {
      "const": "1.0.0"
    },
    "canonVersion": {
      "const": "2.0"
    },
    "sourceResultId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
    },
    "status": {
      "enum": [
        "READY",
        "UNRESOLVED"
      ]
    },
    "strongestObservation": {
      "anyOf": [
        {
          "$ref": "#/$defs/sentence"
        },
        {
          "type": "null"
        }
      ]
    },
    "overview": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sentence"
      }
    },
    "dailyLife": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sentence"
      }
    },
    "questionToSitWith": {
      "anyOf": [
        {
          "$ref": "#/$defs/sentence"
        },
        {
          "type": "null"
        }
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sentence"
      }
    },
    "evidenceRefs": {
      "$ref": "#/$defs/refs"
    },
    "decisionRefs": {
      "$ref": "#/$defs/refs"
    },
    "meaningUnitRefs": {
      "$ref": "#/$defs/refs"
    },
    "unresolved": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasonCodes",
            "explanation"
          ],
          "properties": {
            "reasonCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "explanation": {
              "$ref": "#/$defs/sentence"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "strongestObservation": {
            "$ref": "#/$defs/supportedSentence"
          },
          "overview": {
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/supportedSentence"
            }
          },
          "dailyLife": {
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/supportedSentence"
            }
          },
          "questionToSitWith": {
            "$ref": "#/$defs/supportedSentence"
          },
          "alternatives": {
            "items": {
              "$ref": "#/$defs/supportedSentence"
            }
          },
          "evidenceRefs": {
            "minItems": 1
          },
          "decisionRefs": {
            "minItems": 1
          },
          "meaningUnitRefs": {
            "minItems": 1
          },
          "unresolved": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "strongestObservation": {
            "type": "null"
          },
          "overview": {
            "maxItems": 0
          },
          "dailyLife": {
            "maxItems": 0
          },
          "questionToSitWith": {
            "type": "null"
          },
          "alternatives": {
            "maxItems": 0
          },
          "decisionRefs": {
            "minItems": 1
          },
          "meaningUnitRefs": {
            "maxItems": 0
          },
          "unresolved": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
      }
    },
    "nonemptyRefs": {
      "allOf": [
        {
          "$ref": "#/$defs/refs"
        }
      ],
      "minItems": 1
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceRefs",
        "decisionRefs",
        "meaningUnitRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "$ref": "#/$defs/refs"
        },
        "decisionRefs": {
          "$ref": "#/$defs/nonemptyRefs"
        },
        "meaningUnitRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "supportedSentence": {
      "allOf": [
        {
          "$ref": "#/$defs/sentence"
        }
      ],
      "properties": {
        "evidenceRefs": {
          "minItems": 1
        },
        "meaningUnitRefs": {
          "minItems": 1
        }
      }
    }
  }
}
